# Khalid Leads Agent - local configuration (no secrets here)
# Copy to .env (01_install.bat does it automatically). Most options can also be changed from the Settings page.

APP_HOST=127.0.0.1
APP_PORT=8765

AGENT_OWNER=خالد

ODOO_BASE_URL=https://worldofss.odoo.com

GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=
# oauth (recommended) or service_account
GOOGLE_AUTH_MODE=oauth

# Dry Run is ON by default: nothing is written to Odoo or Google Sheet until you turn it off in Settings.
DRY_RUN=true

BROWSER_HEADLESS=false
# chromium (installed by 01_install.bat), chrome or msedge
BROWSER_CHANNEL=chromium
BROWSER_EXECUTABLE_PATH=

LOG_LEVEL=INFO
OPEN_BROWSER_ON_START=true

# Development only: fictional in-memory sheet + fake Odoo (never touches real systems)
USE_MOCKS=false
